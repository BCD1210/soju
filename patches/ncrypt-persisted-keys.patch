+/* Persistent key storage.
+ *
+ * Windows keeps a user's CNG keys under %APPDATA%\Microsoft\Crypto\Keys, so a
+ * named key created by one run of a program is still there for the next one.
+ * Callers that bind a token to a device key (DPoP, for instance) treat the key
+ * as the identity of the machine and issue a fresh login whenever it changes,
+ * so the key has to outlive the process. */
+
+#define KEY_STORE_MAGIC 0x314b4a53
+
+#ifndef NCRYPT_OVERWRITE_KEY_FLAG
+#define NCRYPT_OVERWRITE_KEY_FLAG 0x00000080
+#endif
+
+struct key_store_header
+{
+    DWORD magic;
+    DWORD algid;
+    DWORD blob_len;
+};
+
+static const WCHAR *blob_type_for_algid(enum algid algid)
+{
+    switch (algid)
+    {
+    case RSA:        return BCRYPT_RSAFULLPRIVATE_BLOB;
+    case ECDSA_P256:
+    case ECDSA_P384: return BCRYPT_ECCPRIVATE_BLOB;
+    default:         return NULL;
+    }
+}
+
+static BCRYPT_ALG_HANDLE alg_handle_for_algid(enum algid algid)
+{
+    switch (algid)
+    {
+    case RSA:        return BCRYPT_RSA_ALG_HANDLE;
+    case ECDSA_P256: return BCRYPT_ECDSA_P256_ALG_HANDLE;
+    case ECDSA_P384: return BCRYPT_ECDSA_P384_ALG_HANDLE;
+    default:         return NULL;
+    }
+}
+
+/* Build %APPDATA%\Microsoft\Crypto\Keys\<name>.key, creating the directories.
+ * Characters that cannot appear in a file name are folded to '_'; a caller
+ * that picks two names differing only in those is left sharing one file. */
+static WCHAR *key_store_path(const WCHAR *name)
+{
+    static const WCHAR keysW[] = L"\\Microsoft\\Crypto\\Keys";
+    static const WCHAR extW[] = L".key";
+    WCHAR appdata[MAX_PATH], *path, *p;
+    DWORD len;
+    size_t i;
+
+    if (!name || !*name) return NULL;
+    if (!(len = GetEnvironmentVariableW(L"APPDATA", appdata, MAX_PATH)) || len >= MAX_PATH) return NULL;
+
+    len = lstrlenW(appdata) + ARRAY_SIZE(keysW) + lstrlenW(name) + ARRAY_SIZE(extW) + 1;
+    if (!(path = malloc(len * sizeof(WCHAR)))) return NULL;
+
+    lstrcpyW(path, appdata);
+    lstrcatW(path, keysW);
+
+    /* create the directories one component at a time */
+    for (p = path + lstrlenW(appdata) + 1; *p; p++)
+    {
+        if (*p != '\\') continue;
+        *p = 0;
+        CreateDirectoryW(path, NULL);
+        *p = '\\';
+    }
+    CreateDirectoryW(path, NULL);
+
+    lstrcatW(path, L"\\");
+    i = lstrlenW(path);
+    for (; *name; name++, i++)
+    {
+        WCHAR c = *name;
+        if (c < ' ' || c == '\\' || c == '/' || c == ':' || c == '*' ||
+            c == '?' || c == '"' || c == '<' || c == '>' || c == '|') c = '_';
+        path[i] = c;
+    }
+    path[i] = 0;
+    lstrcatW(path, extW);
+    return path;
+}
+
+static SECURITY_STATUS write_key_store(const WCHAR *name, enum algid algid, BCRYPT_KEY_HANDLE bcrypt_key,
+                                       BOOL overwrite)
+{
+    struct key_store_header header;
+    const WCHAR *blob_type;
+    SECURITY_STATUS ret = NTE_INTERNAL_ERROR;
+    BYTE *blob = NULL;
+    WCHAR *path, *tmp = NULL;
+    DWORD blob_len = 0, written;
+    NTSTATUS status;
+    HANDLE file;
+
+    if (!(blob_type = blob_type_for_algid(algid))) return NTE_NOT_SUPPORTED;
+    if (!(path = key_store_path(name))) return NTE_INTERNAL_ERROR;
+    /* Write next to the final name and rename over it, so a crash or a full
+     * disk mid-write cannot leave a truncated key behind: that would fail to
+     * open (NTE_BAD_KEYSET) yet count as existing (NTE_EXISTS) forever. */
+    if (!(tmp = malloc((lstrlenW(path) + 5) * sizeof(WCHAR)))) { ret = NTE_NO_MEMORY; goto done; }
+    lstrcpyW(tmp, path);
+    lstrcatW(tmp, L".tmp");
+
+    status = BCryptExportKey(bcrypt_key, NULL, blob_type, NULL, 0, &blob_len, 0);
+    if (status != STATUS_SUCCESS) goto done;
+    if (!(blob = malloc(blob_len))) { ret = NTE_NO_MEMORY; goto done; }
+    status = BCryptExportKey(bcrypt_key, NULL, blob_type, blob, blob_len, &blob_len, 0);
+    if (status != STATUS_SUCCESS) goto done;
+
+    file = CreateFileW(tmp, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE) goto done;
+
+    header.magic = KEY_STORE_MAGIC;
+    header.algid = algid;
+    header.blob_len = blob_len;
+    if (WriteFile(file, &header, sizeof(header), &written, NULL) && written == sizeof(header) &&
+        WriteFile(file, blob, blob_len, &written, NULL) && written == blob_len &&
+        FlushFileBuffers(file))
+        ret = ERROR_SUCCESS;
+    CloseHandle(file);
+    if (ret == ERROR_SUCCESS)
+    {
+        /* Without NCRYPT_OVERWRITE_KEY_FLAG the rename must not replace a key
+         * another process finalized since the creation-time check: two
+         * launches racing to create the same key would otherwise both succeed
+         * and the second would silently discard the first's identity. A file
+         * that is there but does not hold a readable key is replaced anyway. */
+        if (!MoveFileExW(tmp, path, overwrite ? MOVEFILE_REPLACE_EXISTING : 0))
+        {
+            if (overwrite || GetLastError() != ERROR_ALREADY_EXISTS) ret = NTE_INTERNAL_ERROR;
+            else if (key_store_exists(name)) ret = NTE_EXISTS;
+            else if (!MoveFileExW(tmp, path, MOVEFILE_REPLACE_EXISTING)) ret = NTE_INTERNAL_ERROR;
+        }
+    }
+    if (ret != ERROR_SUCCESS) DeleteFileW(tmp);
+
+done:
+    free(blob);
+    free(tmp);
+    free(path);
+    return ret;
+}
+
+static SECURITY_STATUS read_key_store(const WCHAR *name, enum algid *algid, BCRYPT_KEY_HANDLE *bcrypt_key,
+                                      DWORD *bitlen)
+{
+    struct key_store_header header;
+    SECURITY_STATUS ret = NTE_BAD_KEYSET;
+    BYTE *blob = NULL;
+    WCHAR *path;
+    DWORD read;
+    HANDLE file;
+
+    if (!(path = key_store_path(name))) return NTE_BAD_KEYSET;
+
+    file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    free(path);
+    if (file == INVALID_HANDLE_VALUE) return NTE_BAD_KEYSET;
+
+    if (!ReadFile(file, &header, sizeof(header), &read, NULL) || read != sizeof(header) ||
+        header.magic != KEY_STORE_MAGIC || !header.blob_len || header.blob_len > 0x10000)
+        goto done;
+    if (!blob_type_for_algid(header.algid) || !alg_handle_for_algid(header.algid)) goto done;
+    if (!(blob = malloc(header.blob_len))) { ret = NTE_NO_MEMORY; goto done; }
+    if (!ReadFile(file, blob, header.blob_len, &read, NULL) || read != header.blob_len) goto done;
+
+    if (BCryptImportKeyPair(alg_handle_for_algid(header.algid), NULL, blob_type_for_algid(header.algid),
+                            bcrypt_key, blob, header.blob_len, 0) != STATUS_SUCCESS)
+        goto done;
+
+    /* Take the length from the blob rather than assuming the default for its
+     * algorithm: a caller that asked for a 2048 bit RSA key would otherwise be
+     * told its reopened key is 1024 bits. */
+    *bitlen = 0;
+    if (header.algid == RSA)
+    {
+        if (header.blob_len >= sizeof(BCRYPT_RSAKEY_BLOB))
+            *bitlen = ((BCRYPT_RSAKEY_BLOB *)blob)->BitLength;
+    }
+    else if (header.blob_len >= sizeof(BCRYPT_ECCKEY_BLOB))
+        *bitlen = ((BCRYPT_ECCKEY_BLOB *)blob)->cbKey * 8;
+
+    *algid = header.algid;
+    ret = ERROR_SUCCESS;
+
+done:
+    free(blob);
+    CloseHandle(file);
+    return ret;
+}
+
+/* A stored key counts as existing only if it can be read back and imported.
+ * A damaged file, whatever the damage, must look absent: otherwise the
+ * caller's open fails with NTE_BAD_KEYSET, its create then fails with
+ * NTE_EXISTS, and nothing short of deleting the file by hand gets it out of
+ * that loop. */
+static BOOL key_store_exists(const WCHAR *name)
+{
+    BCRYPT_KEY_HANDLE bcrypt_key;
+    enum algid algid;
+    DWORD bitlen;
+
+    if (read_key_store(name, &algid, &bcrypt_key, &bitlen) != ERROR_SUCCESS) return FALSE;
+    BCryptDestroyKey(bcrypt_key);
+    return TRUE;
+}
