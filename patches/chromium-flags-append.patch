--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -1719,10 +1719,33 @@
 /***********************************************************************
  *           SetEnvironmentVariableW   (kernelbase.@)
  */
+
+/* Soju: let the launcher environment append Chromium switches to
+ * QTWEBENGINE_CHROMIUM_FLAGS even when the application overwrites that variable
+ * itself (GOG Galaxy does). SOJU_CHROMIUM_FLAGS holds the switches to append.
+ * Returns a heap buffer the caller must free, or NULL when nothing applies. */
+static WCHAR *soju_append_chromium_flags( const WCHAR *name, const WCHAR *value )
+{
+    WCHAR extra[1024];
+    DWORD len, vlen;
+    WCHAR *ret;
+
+    if (!name || !value || wcsicmp( name, L"QTWEBENGINE_CHROMIUM_FLAGS" )) return NULL;   /* NULL value = delete */
+    len = GetEnvironmentVariableW( L"SOJU_CHROMIUM_FLAGS", extra, ARRAY_SIZE(extra) );
+    if (!len || len >= ARRAY_SIZE(extra)) return NULL;
+    if (value && wcsstr( value, extra )) return NULL;
+    vlen = value ? lstrlenW( value ) : 0;
+    if (!(ret = HeapAlloc( GetProcessHeap(), 0, (vlen + len + 2) * sizeof(WCHAR) ))) return NULL;
+    if (vlen) { lstrcpyW( ret, value ); ret[vlen] = ' '; lstrcpyW( ret + vlen + 1, extra ); }
+    else lstrcpyW( ret, extra );
+    return ret;
+}
+
 BOOL WINAPI DECLSPEC_HOTPATCH SetEnvironmentVariableW( LPCWSTR name, LPCWSTR value )
 {
     UNICODE_STRING us_name, us_value;
     NTSTATUS status;
+    WCHAR *soju_value;
 
     TRACE( "(%s %s)\n", debugstr_w(name), debugstr_w(value) );
 
@@ -1732,6 +1755,12 @@
         return FALSE;
     }
 
+    if ((soju_value = soju_append_chromium_flags( name, value )))
+    {
+        FIXME( "Soju: appending SOJU_CHROMIUM_FLAGS to %s\n", debugstr_w(name) );
+        value = soju_value;
+    }
+
     RtlInitUnicodeString( &us_name, name );
     if (value)
     {
@@ -1740,6 +1769,7 @@
     }
     else status = RtlSetEnvironmentVariable( NULL, &us_name, NULL );
 
+    HeapFree( GetProcessHeap(), 0, soju_value );
     return set_ntstatus( status );
 }
 
