 // Returns a translated binding for the existing binding and translation offset, creating it if needed.
+// SOJU zero-missing-vertex-attributes: give every used, undescribed vertex shader input an attribute
+// in a dedicated constant-step buffer that the encoder fills with zeros at draw time.
+void MVKGraphicsPipeline::addZeroVertexAttributes(MTLVertexDescriptor* inputDesc,
+												  const VkPipelineVertexInputStateCreateInfo* pVI,
+												  const SPIRVShaderInputs& vtxInputs) {
+	uint32_t zeroIdx = kMVKUndefinedLargeUInt32;
+	for (auto& input : vtxInputs) {
+		// Every declared input that has no Metal attribute yet. MoltenVK leaves out locations it judges unused,
+		// even when the Vulkan pipeline describes them, but Metal still checks the shader's declared inputs.
+		if (input.builtin != spv::BuiltInMax || input.location >= 31 || inputDesc.attributes[input.location].format != MTLVertexFormatInvalid) { continue; }
+		if (zeroIdx == kMVKUndefinedLargeUInt32) {
+			// The first Vulkan binding number above every binding this pipeline uses, including translated ones.
+			for (uint32_t b = 0; b < kMVKMaxBufferCount; b++) {
+				uint32_t idx = getMetalBufferIndexForVertexAttributeBinding(b);
+				bool taken = _mtlVertexBuffers.get(idx) || inputDesc.layouts[idx].stride != 0;
+				for (uint32_t j = 0; j < pVI->vertexBindingDescriptionCount; j++) {
+					if (pVI->pVertexBindingDescriptions[j].binding >= b) { taken = true; }
+				}
+				if (!taken) { zeroIdx = idx; break; }
+			}
+			if (zeroIdx == kMVKUndefinedLargeUInt32) { return; }
+			inputDesc.layouts[zeroIdx].stride = 16;	// Metal wants a stride even for a constant step; 16 bytes covers a 4-component input.
+			inputDesc.layouts[zeroIdx].stepFunction = MTLVertexStepFunctionConstant;
+			inputDesc.layouts[zeroIdx].stepRate = 0;
+		}
+		uint32_t width = std::max(1u, std::min(input.vecWidth, 4u)) - 1;
+		static const MTLVertexFormat floats[] = { MTLVertexFormatFloat, MTLVertexFormatFloat2, MTLVertexFormatFloat3, MTLVertexFormatFloat4 };
+		static const MTLVertexFormat ints[]   = { MTLVertexFormatInt, MTLVertexFormatInt2, MTLVertexFormatInt3, MTLVertexFormatInt4 };
+		static const MTLVertexFormat uints[]  = { MTLVertexFormatUInt, MTLVertexFormatUInt2, MTLVertexFormatUInt3, MTLVertexFormatUInt4 };
+		MTLVertexFormat format = floats[width];
+		if (input.baseType == SPIRV_CROSS_NAMESPACE::SPIRType::Int) { format = ints[width]; }
+		if (input.baseType == SPIRV_CROSS_NAMESPACE::SPIRType::UInt) { format = uints[width]; }
+		auto vaDesc = inputDesc.attributes[input.location];
+		vaDesc.format = format;
+		vaDesc.bufferIndex = zeroIdx;
+		vaDesc.offset = 0;
+		reportMessage(MVK_CONFIG_LOG_LEVEL_INFO, "Vertex shader input at location %u is not in the vertex input state; it reads zero.", input.location);
+	}
+	_zeroVertexAttributeBufferIndex = zeroIdx;
+}
