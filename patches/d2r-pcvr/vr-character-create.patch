@@ -0,0 +1,28 @@
+#include "frontend_controls.h"
+#include <cassert>
+#include <cstdio>
+using namespace framevr;
+int main(){
+    frontend::Controls c;menus::Pad p;
+    c.Step(1,p,0);p.lx=25000;c.Step(1,p,1);assert(c.selected==1);
+    p={};p.buttons=menus::A;assert(c.Step(1,p,2).pad.buttons==menus::Start);
+    assert(!c.Step(2,p,3).pad.buttons);auto out=c.Step(3,p,4);assert(!out.text&&!out.pad.buttons);
+    p={};c.Step(3,p,5);p.buttons=menus::A;assert(c.Step(3,p,6).text=='a');
+    assert(!c.Step(3,p,7).text);p={};c.Step(3,p,8);
+    p.lx=-25000;c.Step(3,p,9);assert(c.selected==29);
+    c.Step(3,p,10);assert(c.selected==29);
+    c.Step(3,p,409);assert(c.selected==28);
+    p={};p.buttons=menus::A;assert(c.Step(3,p,410).erase);
+    p={};c.Step(3,p,411);p.buttons=menus::B;assert(c.Step(3,p,412).pad.buttons==menus::B);
+    assert(c.Step(3,p,413).pad.buttons==menus::B);
+    c.Step(0,p,414);assert(!c.Visible());
+    c.Step(3,{},415);p={};p.buttons=menus::Y;c.Step(3,p,416);
+    c.Step(3,{},417);p.buttons=menus::A;assert(c.Step(3,p,418).text=='A');
+    c.Step(1,{},500);p={};p.buttons=menus::B;
+    out=c.Step(1,p,501);assert(out.back&&!out.pad.buttons);
+    assert(!c.Step(1,p,502).back);
+    assert(!c.Step(0,p,503).pad.buttons); // no held B in confirmation
+    c.Step(0,{},504);assert(c.Step(0,p,505).pad.buttons==menus::B);
+    assert(!c.Step(1,p,506).back); // closing confirmation cannot reopen it
+    puts("Front-end navigation and name keyboard passed");
+}
