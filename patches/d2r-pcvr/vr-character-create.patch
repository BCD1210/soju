diff --git a/steamvr/frontend_controls.h b/steamvr/frontend_controls.h
new file mode 100644
index 0000000..f716007
--- /dev/null
+++ b/steamvr/frontend_controls.h
@@ -0,0 +1,52 @@
+#pragma once
+#include "menu_controls.h"
+
+namespace framevr::frontend {
+constexpr int Width=960,Height=360;
+constexpr unsigned NameKeyMessage=0x8000+0x3a1;
+// Native screen values are published by the UI-message listener. Name input
+// uses the game's focused text box, so validation and physical typing stay native.
+struct Output {menus::Pad pad;char text=0;bool erase=false,back=false;};
+struct Controls {
+    int screen=0,selected=0,direction=0;
+    uint16_t held=0xffff,blocked=0;
+    uint64_t repeatAt=0;
+    bool upper=false;
+    bool Visible() const{return screen==1||screen==3;}
+    Output Step(int next,menus::Pad pad,uint64_t now) {
+        if(next!=screen){screen=next;selected=0;direction=0;repeatAt=0;held=pad.buttons;blocked=pad.buttons;}
+        blocked&=pad.buttons;pad.buttons&=~blocked;
+        const auto pressed=uint16_t(pad.buttons&~held);held=pad.buttons;
+        Output out{pad};
+        if(!Visible())return out;
+        const int dx=pad.lx>16000?1:pad.lx<-16000?-1:0;
+        const int dy=screen==3?(pad.ly>16000?-10:pad.ly<-16000?10:0):0;
+        const int move=dx?dx:dy;
+        if(move&&(move!=direction||now>=repeatAt)) {
+            selected=screen==1?std::clamp(selected+move,0,1):(selected+move+30)%30;
+            repeatAt=now+(move!=direction?400:140);
+        }
+        direction=move;
+        out.pad.lx=0;
+        if(screen==1) {
+            out.back=(pressed&menus::B)!=0;out.pad.buttons&=~menus::B;
+            if(selected==1&&(pad.buttons&menus::A)){out.pad.buttons&=~menus::A;out.pad.buttons|=menus::Start;}
+            return out;
+        }
+        out.pad={};
+        if(pressed&menus::B){out.pad.buttons=menus::B;return out;}
+        if(pressed&menus::Y)upper=!upper;
+        if(pressed&menus::X)out.erase=true;
+        if(pressed&menus::A) {
+            if(selected<26)out.text=char((upper?'A':'a')+selected);
+            else if(selected<28)out.text=selected==26?'-':'_';
+            else if(selected==28)out.erase=true;
+            else out.pad.buttons=menus::A;
+        }
+        // Native buttons need a sampled hold, not a one-frame pulse.
+        if((held&menus::B))out.pad.buttons=menus::B;
+        if(selected==29&&(held&menus::A))out.pad.buttons=menus::A;
+        return out;
+    }
+};
+}
diff --git a/steamvr/frontend_controls_art.h b/steamvr/frontend_controls_art.h
new file mode 100644
index 0000000..61c9dd9
--- /dev/null
+++ b/steamvr/frontend_controls_art.h
@@ -0,0 +1,35 @@
+#pragma once
+#include <windows.h>
+#include <vector>
+#include "frontend_controls.h"
+namespace framevr::frontend {
+inline std::vector<uint8_t> Paint(const Controls& model) {
+    std::vector<uint8_t> rgba(size_t(Width)*Height*4);
+    BITMAPINFO info{};info.bmiHeader.biSize=sizeof(BITMAPINFOHEADER);
+    info.bmiHeader.biWidth=Width;info.bmiHeader.biHeight=-Height;info.bmiHeader.biPlanes=1;info.bmiHeader.biBitCount=32;
+    HDC dc=CreateCompatibleDC(nullptr);void* bits=nullptr;
+    HBITMAP bitmap=dc?CreateDIBSection(dc,&info,DIB_RGB_COLORS,&bits,nullptr,0):nullptr;
+    if(!dc||!bitmap||!bits){if(bitmap)DeleteObject(bitmap);if(dc)DeleteDC(dc);return {};}
+    const auto old=SelectObject(dc,bitmap);
+    auto fill=[&](RECT r,COLORREF c){auto b=CreateSolidBrush(c);FillRect(dc,&r,b);DeleteObject(b);};
+    fill({0,0,Width,Height},RGB(18,16,14));
+    auto font=CreateFontW(28,0,0,0,FW_SEMIBOLD,FALSE,FALSE,FALSE,DEFAULT_CHARSET,OUT_DEFAULT_PRECIS,
+        CLIP_DEFAULT_PRECIS,ANTIALIASED_QUALITY,DEFAULT_PITCH,L"Segoe UI");
+    const auto oldFont=SelectObject(dc,font);SetBkMode(dc,TRANSPARENT);SetTextColor(dc,RGB(245,235,210));
+    auto text=[&](const wchar_t* t,RECT r){DrawTextW(dc,t,-1,&r,DT_CENTER|DT_VCENTER|DT_SINGLELINE|DT_NOPREFIX);};
+    text(model.screen==1?L"CHARACTERS   |   A: select   B: back":L"CHARACTER NAME",{12,4,Width-12,48});
+    text(model.screen==1?L"Stick left/right: Play / New   |   Up/down: character":L"Stick: move   A: type   X: erase   Y: case   B: back",{12,Height-52,Width-12,Height-8});
+    const int count=model.screen==1?2:30;
+    for(int i=0;i<count;++i){
+        RECT r=model.screen==1?RECT{40+i*460,85,460+i*460,255}:RECT{18+(i%10)*93,58+(i/10)*78,105+(i%10)*93,128+(i/10)*78};
+        fill(r,i==model.selected?RGB(150,107,42):RGB(48,43,36));
+        wchar_t letter[2]={wchar_t((model.upper?'A':'a')+i),0};
+        const wchar_t* label=model.screen==1?(i?L"New":L"Play"):i<26?letter:i==26?L"-":i==27?L"_":i==28?L"Erase":L"Create";
+        text(label,r);
+    }
+    GdiFlush();const auto* bgra=static_cast<const uint8_t*>(bits);
+    for(size_t i=0;i<rgba.size();i+=4){rgba[i]=bgra[i+2];rgba[i+1]=bgra[i+1];rgba[i+2]=bgra[i];rgba[i+3]=255;}
+    SelectObject(dc,oldFont);DeleteObject(font);SelectObject(dc,old);DeleteObject(bitmap);DeleteDC(dc);
+    return rgba;
+}
+}
