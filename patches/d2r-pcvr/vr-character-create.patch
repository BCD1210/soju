 using namespace framevr;
 static void Check(bool ok,const char* message){if(!ok){std::fprintf(stderr,"FAIL: %s\n",message);std::exit(1);}}
 int main(){
+    // Simulator owns desktop focus while the anchored title/class picker consumes XInput.
+    for(bool focused:{false,true})for(bool frontend:{false,true})for(bool placed:{false,true}) {
+        menus::Navigation nav;
+        menus::Pad stick;stick.lx=24000;
+        const bool active=menus::NavigationActive(placed,focused,frontend);
+        Check(active==(placed&&(focused||frontend)),"front-end navigation focus policy");
+        auto report=nav.Step(active,stick,false,0,0,false);
+        Check((report.lx==24000)==active,"only anchored front-end pad bypasses desktop focus");
+        menus::Pad accept;accept.buttons=menus::A;
+        report=nav.Step(active,accept,false,0,0,false);
+        Check(bool(report.buttons&menus::A)==active,"class selection A reaches native UI without a laser hit");
+        report=nav.Step(active,{},false,0,0,false);
+        Check(!menus::Busy(report),"A release reaches native UI while simulator retains focus");
+        Check(menus::Allowed(uint32_t(menus::Mode::Native),7,7,true,false),"front-end mirror accepts Native tag");
+        Check(!menus::Allowed(uint32_t(menus::Mode::Native),7,8,true,false),"stale character panel epoch is rejected");
+        panels::MouseGate mouse;
+        Check(mouse.Step(placed&&focused,true,true,false).press[0]==(placed&&focused),
+              "front-end exemption never injects a background mouse click");
+    }
+
     for(int preset=0;preset<3;++preset)for(bool main:{false,true}) {
         const float distance=panels::MenuDistance(preset,main);
         Check(std::fabs(distance-(main?.70f:.55f)-.30f*preset)<.00001f,"distance presets add 30 cm without changing canvas scale");
