--- a/steamvr/composition_layers.h
+++ b/steamvr/composition_layers.h
@@ -2,6 +2,22 @@
 #include <openxr/openxr.h>
 
 namespace framevr::composition {
+// Some streaming runtimes need a projection source before they can composite
+// quads. A black texel supplies an opaque background without flattening the
+// menu: the following quads retain their world-space pose and stereo depth.
+inline void BlackBackdrop(XrCompositionLayerProjection& layer,
+                          XrCompositionLayerProjectionView (&eyes)[2],
+                          const XrView* views,XrSpace space,XrSwapchain atlas,
+                          XrOffset2Di blackTexel) {
+    layer={XR_TYPE_COMPOSITION_LAYER_PROJECTION};layer.space=space;
+    layer.viewCount=2;layer.views=eyes;
+    for(int i=0;i<2;++i) {
+        eyes[i]={XR_TYPE_COMPOSITION_LAYER_PROJECTION_VIEW};
+        eyes[i].pose=views[i].pose;eyes[i].fov=views[i].fov;
+        eyes[i].subImage.swapchain=atlas;
+        eyes[i].subImage.imageRect={blackTexel,{1,1}};
+    }
+}
 // Proton Experimental's win64 layer-array converter (observed 2026-10-09)
 // sizes EVERY output element from input[0]->type. Projection is 48 bytes;
 // quad is 112. A projection followed by quads therefore overlaps outputs.
