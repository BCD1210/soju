diff --git a/steamvr/pad_mirror_policy.h b/steamvr/pad_mirror_policy.h
new file mode 100644
index 0000000..7e57d71
--- /dev/null
+++ b/steamvr/pad_mirror_policy.h
@@ -0,0 +1,18 @@
+#pragma once
+#include "../external/bodywalk/pad_mirror_shared.h"
+#include "menu_controls.h"
+
+namespace framevr::menus {
+// Internal XR publication can pause during loading. Keep that virtual device
+// connected, but release every control. External writers still time out.
+inline bool CopyMirror(const BWPadMirror& source,bool fresh,uint32_t owner,BWPadMirror& out) {
+    if(source.version!=BW_PAD_MIRROR_VERSION)return false;
+    if(!fresh&&(source.writer_pid!=owner||!Tagged(source.reserved[0])))return false;
+    out=source;
+    if(!fresh) {
+        out.buttons=0;out.left_trigger=out.right_trigger=0;
+        out.thumb_lx=out.thumb_ly=out.thumb_rx=out.thumb_ry=0;
+    }
+    return true;
+}
+}
