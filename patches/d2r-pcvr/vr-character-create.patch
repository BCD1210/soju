+// Front-end XInput does not require desktop focus (the simulator owns its keys).
+// Gameplay menus and injected mouse input still require the game window's focus.
+inline bool NavigationActive(bool uiActive,bool focused,bool frontend) {
+    return uiActive&&(focused||frontend);
+}
+// Wine's title panel accepts window key messages but can ignore native pad
+// events before its controller UI exists. Consume one fresh accept through the
+// transition so a held title press cannot also enter the selected character.
+class TitleAccept {
+    bool down=true,consumed=false;
+public:
+    bool Step(bool active,bool title,Pad& pad) {
+        const bool pressed=(pad.buttons&(A|Start))!=0;
+        const bool fire=active&&title&&pressed&&!down;
+        if(!pressed)consumed=false;
+        if(fire)consumed=true;
+        down=pressed||!active;
+        if(consumed)pad.buttons&=~(A|Start);
+        return fire;
+    }
+};
