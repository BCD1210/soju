--- a/dlls/xgameruntime/xstore_entitled.h	2026-11-01 20:47:52
+++ b/dlls/xgameruntime/xstore_entitled.h	2026-11-01 20:47:52
@@ -469,6 +469,24 @@
     IXThreadingImpl_Release(threading); return hr;
