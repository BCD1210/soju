+
+/* Soju: replay a batch of queued 32-bit immediate-mode calls (see wgl.c) through the regular
+ * per-function entry points, in order, so context state tracking stays the same. */
+extern const unixlib_entry_t __wine_unix_call_funcs[];
+
+static NTSTATUS replay_gl_batch( TEB *teb, const BYTE *data, UINT32 size )
+{
+    struct
+    {
+        TEB *teb;
+        BYTE data[64];
+    } DECLSPEC_ALIGN(8) args;
+
+    while (size >= 2 * sizeof(UINT32))
+    {
+        UINT32 code = ((const UINT32 *)data)[0], len = ((const UINT32 *)data)[1];
+        UINT32 step = 2 * sizeof(UINT32) + ((len + 3) & ~3);
+
+        if (code >= funcs_count || len > sizeof(args.data) || step > size) return STATUS_INVALID_PARAMETER;
+        args.teb = teb;
+        memcpy( args.data, data + 2 * sizeof(UINT32), len );
+        __wine_unix_call_funcs[code]( &args );
+        data += step;
+        size -= step;
+    }
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS wine_gl_batch( void *args )
+{
+    struct wine_gl_batch_params *params = args;
+    return replay_gl_batch( params->teb, params->data, params->size );
+}
+
+#ifdef _WIN64
+NTSTATUS wow64_wine_gl_batch( void *args )
+{
+    struct
+    {
+        PTR32 teb;
+        PTR32 data;
+        UINT32 size;
+    } *params = args;
+    return replay_gl_batch( get_teb64( params->teb ), ULongToPtr( params->data ), params->size );
+}
+#endif
