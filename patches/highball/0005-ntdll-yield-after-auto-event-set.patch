diff -ruN a/dlls/ntdll/unix/msync.c b/dlls/ntdll/unix/msync.c
--- a/dlls/ntdll/unix/msync.c	2026-09-04 15:37:32
+++ b/dlls/ntdll/unix/msync.c	2026-09-04 15:37:32
@@ -700,7 +700,16 @@
     LONG current;
 
     if (!(current = __atomic_exchange_n( &event->signaled, 1, __ATOMIC_SEQ_CST )))
+    {
         signal_all( (void *)event, obj );
+        /* Highball: Windows boosts the thread woken by an auto-reset event so it usually runs
+         * before the setter continues. Without that, a setter that signals twice in a row
+         * before the waiter is scheduled loses the second wake-up (the event is already
+         * signaled) and a job hand-off that relies on one wake per signal deadlocks. Seen in
+         * CS:GO's map load on macOS 26 under Rosetta. Yield after the transition so the
+         * waiter gets the CPU first. */
+        if (event->msync_type == MSYNC_AUTO_EVENT) sched_yield();
+    }
 
     if (prev_state) *prev_state = current;
 
diff -ruN a/dlls/ntdll/unix/sync.c b/dlls/ntdll/unix/sync.c
--- a/dlls/ntdll/unix/sync.c	2026-09-04 15:37:32
+++ b/dlls/ntdll/unix/sync.c	2026-09-04 15:37:32
@@ -1268,7 +1268,14 @@
         req->handle = wine_server_obj_handle( handle );
         req->op     = SET_EVENT;
         ret = wine_server_call( req );
-        if (!ret && prev_state) *prev_state = reply->state;
+        if (!ret)
+        {
+            if (prev_state) *prev_state = reply->state;
+            /* Highball: let a thread the server just woke run before we signal again
+             * (see msync_set_event_obj); the server does not tell us the event type, and
+             * the yield is cheap, so it applies to every 0->1 transition here. */
+            if (!reply->state) sched_yield();
+        }
     }
     SERVER_END_REQ;
     return ret;
