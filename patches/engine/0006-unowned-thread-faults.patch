Soju: a fault on a thread Wine did not create (Metal's and D3DMetal's dispatch workers have no
TEB) no longer hangs the program at full CPU. Page faults Wine fixes on its own threads that need
no TEB (Rosetta reporting writes as reads, pages Wine keeps writable and executable, write
watches) are fixed and retried; anything else gets the default action, so the process crashes
with a crash report that names the real fault.

diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index 91926a8..d79dfbe 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -2490,6 +2490,36 @@ static inline BOOL check_invalid_gsbase( ucontext_t *ucontext )
 }
 
 
+#ifdef __APPLE__
+/**********************************************************************
+ *		unowned_thread_signal
+ *
+ * Soju: a SIGSEGV, SIGBUS, SIGTRAP or SIGFPE on a thread Wine did not create. The handlers read
+ * the TEB first, and on a thread without one that faults again inside the handler, which macOS
+ * keeps retrying: the program hangs at full CPU and never draws again. Page faults Wine can fix
+ * without a TEB are fixed and retried; anything else gets the default action, so the process
+ * crashes and its crash report names the real fault. Returns FALSE on Wine's own threads.
+ */
+static BOOL unowned_thread_signal( int signal, siginfo_t *siginfo, ucontext_t *ucontext )
+{
+    struct sigaction dfl;
+
+    if (NtCurrentTeb()) return FALSE;
+    if ((signal == SIGSEGV || signal == SIGBUS) && TRAP_sig(ucontext) == TRAP_x86_PAGEFLT &&
+        virtual_retry_unowned_fault( siginfo->si_addr, (ERROR_sig(ucontext) >> 1) & 0x09 ))
+        return TRUE;
+
+    memset( &dfl, 0, sizeof(dfl) );
+    dfl.sa_handler = SIG_DFL;
+    sigemptyset( &dfl.sa_mask );
+    sigaction( signal, &dfl, NULL );
+    /* a faulting instruction runs again and faults again; a trap has already gone past */
+    if (signal == SIGTRAP) raise( signal );
+    return TRUE;
+}
+#endif
+
+
 /**********************************************************************
  *		segv_handler
  *
@@ -2501,6 +2531,9 @@ static void segv_handler( int signal, siginfo_t *siginfo, void *sigcontext )
     EXCEPTION_RECORD rec = { 0 };
     struct xcontext context;
 
+#ifdef __APPLE__
+    if (unowned_thread_signal( signal, siginfo, ucontext )) return;
+#endif
     rec.ExceptionAddress = (void *)RIP_sig(ucontext);
     save_context( &context, ucontext );
 
@@ -2597,6 +2630,9 @@ static void trap_handler( int signal, siginfo_t *siginfo, void *sigcontext )
     EXCEPTION_RECORD rec = { 0 };
     struct xcontext context;
 
+#ifdef __APPLE__
+    if (unowned_thread_signal( signal, siginfo, ucontext )) return;
+#endif
     if (handle_syscall_trap( ucontext, siginfo )) return;
 
     rec.ExceptionAddress = (void *)RIP_sig(ucontext);
@@ -2631,6 +2667,9 @@ static void fpe_handler( int signal, siginfo_t *siginfo, void *sigcontext )
     EXCEPTION_RECORD rec = { .ExceptionAddress = (void *)RIP_sig(ucontext) };
     struct xcontext context;
 
+#ifdef __APPLE__
+    if (unowned_thread_signal( signal, siginfo, ucontext )) return;
+#endif
     save_context( &context, sigcontext );
 
     switch (siginfo->si_code)
