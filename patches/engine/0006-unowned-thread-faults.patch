diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index 4f8b03d..51de542 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -4542,6 +4542,48 @@ static NTSTATUS grow_thread_stack( char *page, struct thread_stack_info *stack_i
 /***********************************************************************
  *           virtual_handle_fault
  */
+#ifdef __APPLE__
+/***********************************************************************
+ *           virtual_retry_unowned_fault
+ *
+ * Soju: a page fault on a thread Wine did not create (Metal's and D3DMetal's dispatch workers have
+ * no TEB). Fix up the faults Wine fixes for its own threads that need no TEB, and say whether the
+ * access can simply run again: Rosetta reporting a write as a read, writes and executes on pages Wine
+ * keeps writable and executable (CrossOver's hacks 24945 and 25719), writes to write-watched pages.
+ */
+BOOL virtual_retry_unowned_fault( void *addr, ULONG_PTR err )
+{
+    char *page = ROUND_ADDR( addr, host_page_mask );
+    BOOL retry = FALSE;
+    BYTE vprot;
+    int prot;
+
+    mutex_lock( &virtual_mutex );
+    vprot = get_host_page_vprot( page );
+    prot = get_unix_prot( vprot );
+    if (err == EXCEPTION_READ_FAULT && (prot & PROT_READ)) err = EXCEPTION_WRITE_FAULT;
+
+    if ((err == EXCEPTION_WRITE_FAULT && (prot & PROT_WRITE) && (prot & PROT_EXEC)) ||
+        (err == EXCEPTION_EXECUTE_FAULT && (prot & PROT_EXEC)))
+    {
+        mprotect_range( page, page_size, 0, VPROT_EXEC );
+        mprotect_range( page, page_size, VPROT_EXEC, 0 );
+        retry = TRUE;
+    }
+    else if (err == EXCEPTION_WRITE_FAULT)
+    {
+        if (vprot & VPROT_WRITEWATCH)
+        {
+            set_page_vprot_bits( page, host_page_size, 0, VPROT_WRITEWATCH );
+            mprotect_range( page, host_page_size, 0, 0 );
+        }
+        retry = (get_unix_prot( get_host_page_vprot( page ) ) & PROT_WRITE) != 0;
+    }
+    mutex_unlock( &virtual_mutex );
+    return retry;
+}
+#endif
+
 NTSTATUS virtual_handle_fault( EXCEPTION_RECORD *rec, void *stack )
 {
     NTSTATUS ret = STATUS_ACCESS_VIOLATION;
