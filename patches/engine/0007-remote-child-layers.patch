 /**********************************************************************
  *              WindowMessage   (MACDRV.@)
  */
+/***********************************************************************
+ * Soju: child windows drawn here whose top-level window another process owns
+ *
+ * Chromium's GPU process (the EA app, Rockstar Games Launcher, Ubisoft Connect) has DXMT or D3DMetal
+ * draw into a window whose top-level window the browser process owns. This process keeps no window
+ * data for such a child, so there was no view to draw into and the launcher stayed black. Here the
+ * child gets a layer exported to the window server (macdrv_remote_layer_*), and the owner of the
+ * top-level window is told where to show it (WM_MACDRV_PLACE_REMOTE_LAYER) whenever it is made,
+ * moved, resized, shown or hidden, and to drop it (WM_MACDRV_REMOVE_REMOTE_LAYER) when it goes.
+ */
+struct remote_child
+{
+    struct list entry;
+    HWND hwnd;
+    HWND root;
+    macdrv_remote_layer layer;      /* NULL until DXMT or D3DMetal asks for a Metal view */
+    unsigned int context_id;
+};
+
+static struct list remote_children = LIST_INIT(remote_children);
+static pthread_mutex_t remote_children_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static struct remote_child *find_remote_child(const void *ptr, HWND hwnd)
+{
+    struct remote_child *child;
+    LIST_FOR_EACH_ENTRY(child, &remote_children, struct remote_child, entry)
+        if (child == ptr || (hwnd && child->hwnd == hwnd)) return child;
+    return NULL;
+}
+
+static RECT remote_child_client_rect(HWND hwnd)
+{
+    RECT rect;
+    if (!NtUserGetClientRect(hwnd, &rect, NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI))) SetRectEmpty(&rect);
+    return rect;
+}
+
+macdrv_view macdrv_remote_child_view(HWND hwnd)
+{
+    HWND root = NtUserGetAncestor(hwnd, GA_ROOT);
+    struct remote_child *child;
+    DWORD pid = 0;
+
+    if (!root) return NULL;
+    NtUserGetWindowThread(root, &pid);
+    if (!pid || pid == GetCurrentProcessId()) return NULL;
+
+    pthread_mutex_lock(&remote_children_mutex);
+    if (!(child = find_remote_child(NULL, hwnd)) && (child = calloc(1, sizeof(*child))))
+    {
+        child->hwnd = hwnd;
+        child->root = root;
+        list_add_tail(&remote_children, &child->entry);
+    }
+    pthread_mutex_unlock(&remote_children_mutex);
+    TRACE("child %p of %p (process %04x) -> %p\n", hwnd, root, (unsigned)pid, child);
+    return (macdrv_view)child;
+}
+
+BOOL macdrv_is_remote_child(const void *v)
+{
+    BOOL ret;
+    if (!v || list_empty(&remote_children)) return FALSE;
+    pthread_mutex_lock(&remote_children_mutex);
+    ret = find_remote_child(v, NULL) != NULL;
+    pthread_mutex_unlock(&remote_children_mutex);
+    return ret;
+}
+
+macdrv_metal_view macdrv_remote_child_create_metal_view(macdrv_view v, macdrv_metal_device d)
+{
+    struct remote_child *child = (struct remote_child *)v;
+    RECT rect = remote_child_client_rect(child->hwnd);
+    macdrv_remote_layer layer;
+    unsigned int id = 0;
+
+    if (!(layer = macdrv_remote_layer_create(d, cgrect_from_rect(rect), &id))) return NULL;
+    pthread_mutex_lock(&remote_children_mutex);
+    if (child->layer) macdrv_remote_layer_destroy(child->layer);
+    child->layer = layer;
+    child->context_id = id;
+    pthread_mutex_unlock(&remote_children_mutex);
+    TRACE("child %p draws into context %u, shown by %p\n", child->hwnd, id, child->root);
+    NtUserPostMessage(child->root, WM_MACDRV_PLACE_REMOTE_LAYER, (WPARAM)child->hwnd, id);
+    return (macdrv_metal_view)child;
+}
+
+macdrv_metal_layer macdrv_remote_child_metal_layer(macdrv_metal_view v)
+{
+    struct remote_child *child = (struct remote_child *)v;
+    return child->layer ? macdrv_remote_layer_get_metal_layer(child->layer) : NULL;
+}
+
+static void remote_child_free(struct remote_child *child)
+{
+    list_remove(&child->entry);
+    if (child->layer)
+    {
+        NtUserPostMessage(child->root, WM_MACDRV_REMOVE_REMOTE_LAYER, (WPARAM)child->hwnd, child->context_id);
+        macdrv_remote_layer_destroy(child->layer);
+    }
+    free(child);
+}
+
+void macdrv_remote_child_release(macdrv_metal_view v)
+{
+    struct remote_child *child;
+    pthread_mutex_lock(&remote_children_mutex);
+    if ((child = find_remote_child(v, NULL))) remote_child_free(child);
+    pthread_mutex_unlock(&remote_children_mutex);
+}
+
+void macdrv_remote_child_moved(HWND hwnd)
+{
+    struct remote_child *child;
+    if (list_empty(&remote_children)) return;
+    pthread_mutex_lock(&remote_children_mutex);
+    if ((child = find_remote_child(NULL, hwnd)) && child->layer)
+    {
+        macdrv_remote_layer_set_bounds(child->layer, cgrect_from_rect(remote_child_client_rect(hwnd)));
+        NtUserPostMessage(child->root, WM_MACDRV_PLACE_REMOTE_LAYER, (WPARAM)hwnd, child->context_id);
+    }
+    pthread_mutex_unlock(&remote_children_mutex);
+}
+
+void macdrv_remote_child_destroyed(HWND hwnd)
+{
+    struct remote_child *child;
+    if (list_empty(&remote_children)) return;
+    pthread_mutex_lock(&remote_children_mutex);
+    if ((child = find_remote_child(NULL, hwnd))) remote_child_free(child);
+    pthread_mutex_unlock(&remote_children_mutex);
+}
+
+/* The top-level window's side: where the child is now, in the content view's coordinates. */
+static void place_remote_layer(struct macdrv_win_data *data, HWND child, unsigned int id)
+{
+    RECT rect;
+    BOOL visible;
+
+    if (!NtUserIsWindow(child))
+    {
+        macdrv_window_remove_remote_layer(data->cocoa_window, id);
+        return;
+    }
+    rect = remote_child_client_rect(child);
+    visible = NtUserIsWindowVisible(child) && rect.right > rect.left && rect.bottom > rect.top;
+    NtUserMapWindowPoints(child, data->hwnd, (POINT *)&rect, 2, NtUserGetWinMonitorDpi(data->hwnd, MDT_RAW_DPI));
+    OffsetRect(&rect, data->rects.client.left - data->rects.visible.left,
+               data->rects.client.top - data->rects.visible.top);
+    TRACE("context %u of child %p at %s%s\n", id, child, wine_dbgstr_rect(&rect), visible ? "" : " (hidden)");
+    macdrv_window_place_remote_layer(data->cocoa_window, id, child, cgrect_from_rect(rect), visible);
+}
+
+static BOOL hosts_remote_layers;  /* set once this process shows a layer drawn by another */
+
+static void replace_remote_layers(struct macdrv_win_data *data)
+{
+    unsigned int ids[16];
+    void *hwnds[16];
+    int i, count;
+
+    if (!hosts_remote_layers || !data->cocoa_window) return;
+    count = macdrv_window_remote_layers(data->cocoa_window, ids, hwnds, ARRAY_SIZE(ids));
+    for (i = 0; i < count; i++) place_remote_layer(data, hwnds[i], ids[i]);
+}
