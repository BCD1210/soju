+/* Soju: cross-process layers. A Chromium-based launcher draws its pages in a GPU process, into a
+ * child window of a top-level window that its browser process owns. The GPU process has no
+ * NSWindow for it, so it draws into a CAMetalLayer of its own that it exports through a CAContext,
+ * and the browser process shows that layer in its window with a CALayerHost (both private
+ * QuartzCore classes, the same pair upstream Wine uses for cross-process top-level windows). */
+extern uint32_t CGSMainConnectionID(void);
+
+@interface CAContext : NSObject
++ (id) contextWithCGSConnection:(uint32_t)connection options:(NSDictionary*)options;
+@property (readonly) uint32_t contextId;
+@property (retain) CALayer* layer;
+@end
+
+@interface CALayerHost : CALayer
+@property uint32_t contextId;
+@end
+
+@interface SojuRemoteLayer : NSObject
+@property (retain) CAMetalLayer* metalLayer;
+@property (retain) CAContext* context;
+@end
+
+@implementation SojuRemoteLayer
+- (void) observeValueForKeyPath:(NSString*)keyPath ofObject:(id)object change:(NSDictionary*)change context:(void*)ctx
+{
+    CAMetalLayer* layer = _metalLayer;
+    CGSize size = layer.drawableSize;
+    CGFloat scale = layer.contentsScale > 0 ? layer.contentsScale : 1.0;
+
+    if (size.width <= 0 || size.height <= 0) return;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        layer.bounds = CGRectMake(0, 0, size.width / scale, size.height / scale);
+        [CATransaction commit];
+    });
+}
+
+- (void) dealloc
+{
+    [_metalLayer removeObserver:self forKeyPath:@"drawableSize"];
+    [_context setLayer:nil];
+    [_context release];
+    [_metalLayer release];
+    [super dealloc];
+}
+@end
+
+static char soju_remote_hosts_key;
+
+macdrv_remote_layer macdrv_remote_layer_create(macdrv_metal_device d, CGRect bounds, unsigned int *context_id)
+{
+    __block SojuRemoteLayer* remote = nil;
+
+    OnMainThread(^{
+        CAMetalLayer* layer = [CAMetalLayer layer];
+        CAContext* context = [CAContext contextWithCGSConnection:CGSMainConnectionID() options:@{}];
+
+        if (!layer || !context || !context.contextId) return;
+        layer.device = (id<MTLDevice>)d;
+        layer.anchorPoint = CGPointZero;
+        layer.contentsScale = retina_on ? 2.0 : 1.0;
+        layer.bounds = cgrect_mac_from_win(CGRectMake(0, 0, bounds.size.width, bounds.size.height));
+        context.layer = layer;
+        remote = [[SojuRemoteLayer alloc] init];
+        remote.metalLayer = layer;
+        remote.context = context;
+        [layer addObserver:remote forKeyPath:@"drawableSize" options:0 context:NULL];
+    });
+    if (!remote) return NULL;
+    *context_id = remote.context.contextId;
+    return (macdrv_remote_layer)remote;
+}
+
+macdrv_metal_layer macdrv_remote_layer_get_metal_layer(macdrv_remote_layer r)
+{
+    return (macdrv_metal_layer)((SojuRemoteLayer*)r).metalLayer;
+}
+
+void macdrv_remote_layer_set_bounds(macdrv_remote_layer r, CGRect bounds)
+{
+    SojuRemoteLayer* remote = (SojuRemoteLayer*)r;
+
+    OnMainThread(^{
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        remote.metalLayer.bounds = cgrect_mac_from_win(CGRectMake(0, 0, bounds.size.width, bounds.size.height));
+        [CATransaction commit];
+    });
+}
+
+void macdrv_remote_layer_destroy(macdrv_remote_layer r)
+{
+    SojuRemoteLayer* remote = (SojuRemoteLayer*)r;
+    OnMainThreadAsync(^{ [remote release]; });
+}
+
+/* The top-level window's side: one CALayerHost per context id, kept on its content view. */
+void macdrv_window_place_remote_layer(macdrv_window w, unsigned int context_id, void *hwnd, CGRect frame, int visible)
+{
+    WineWindow* window = (WineWindow*)w;
+
+    OnMainThread(^{
+        NSView* view = [window contentView];
+        NSMutableDictionary* hosts;
+        CALayerHost* host;
+
+        if (!view) return;
+        if (!view.layer) view.wantsLayer = YES;
+        if (!(hosts = objc_getAssociatedObject(view, &soju_remote_hosts_key)))
+        {
+            hosts = [NSMutableDictionary dictionary];
+            objc_setAssociatedObject(view, &soju_remote_hosts_key, hosts, OBJC_ASSOCIATION_RETAIN);
+        }
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        if (!(host = [hosts objectForKey:@(context_id)]))
+        {
+            host = [CALayerHost layer];
+            host.contextId = context_id;
+            host.anchorPoint = CGPointZero;
+            host.masksToBounds = YES;
+            [view.layer addSublayer:host];
+            [hosts setObject:host forKey:@(context_id)];
+        }
+        [host setValue:@((uintptr_t)hwnd) forKey:@"sojuHwnd"];
+        host.contentsScale = retina_on ? 2.0 : 1.0;
+        host.frame = [view convertRectToLayer:NSRectFromCGRect(cgrect_mac_from_win(frame))];
+        host.hidden = !visible;
+        [CATransaction commit];
+        if ([window respondsToSelector:@selector(windowDidDrawContent)])
+            [window windowDidDrawContent];
+    });
+}
+
+void macdrv_window_remove_remote_layer(macdrv_window w, unsigned int context_id)
+{
+    WineWindow* window = (WineWindow*)w;
+
+    OnMainThread(^{
+        NSView* view = [window contentView];
+        NSMutableDictionary* hosts = view ? objc_getAssociatedObject(view, &soju_remote_hosts_key) : nil;
+        CALayerHost* host = [hosts objectForKey:@(context_id)];
+
+        [host removeFromSuperlayer];
+        [hosts removeObjectForKey:@(context_id)];
+    });
+}
+
+int macdrv_window_remote_layers(macdrv_window w, unsigned int *context_ids, void **hwnds, int max)
+{
+    WineWindow* window = (WineWindow*)w;
+    __block int count = 0;
+
+    OnMainThread(^{
+        NSView* view = [window contentView];
+        NSMutableDictionary* hosts = view ? objc_getAssociatedObject(view, &soju_remote_hosts_key) : nil;
+
+        for (NSNumber* key in hosts)
+        {
+            if (count == max) break;
+            context_ids[count] = key.unsignedIntValue;
+            hwnds[count] = (void *)(uintptr_t)[[hosts[key] valueForKey:@"sojuHwnd"] unsignedLongLongValue];
+            count++;
+        }
+    });
+    return count;
+}
