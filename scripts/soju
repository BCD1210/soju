#!/usr/bin/env bash
# soju: command-line entry point (used by the Homebrew formula)
set -euo pipefail

# Homebrew installs this file as a symlink in bin/, so resolve links before
# locating the repo, otherwise ROOT becomes the brew prefix and nothing is found.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  target="$(readlink "$SELF")"
  case "$target" in /*) SELF="$target" ;; *) SELF="$(dirname "$SELF")/$target" ;; esac
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"

usage() {
  cat <<'EOF'
soju: open-source Windows launchers on Apple Silicon

Usage:
  soju install        Choose and install any of the eight platforms
  soju app            Build, install and open the native Soju app
  soju library        List installed and imported games as JSON
  soju game <id>      Play a game from the unified library
  soju game-install <id>  Open the official launcher to install an owned game
  soju search <term>  Search Steam, GOG and the Microsoft Store (--country US|KR|GB|DE|JP)
  soju report [<id>|<title>]  Open a compatibility report with this Mac's details filled in
  soju didim install <game.zip>  Install a native Mac game from Didim Labs
  soju didim list|remove <id>    List or remove installed Didim Labs games
  soju didim demo <id>           Download and install a game's free demo
  soju --version      Print the Soju version
  soju battlenet      Launch Battle.net (default bottle)
  soju d2r            Launch Diablo II: Resurrected directly
  soju kill           Stop everything in the Battle.net bottle
  soju controllers    Game Controllers panel of the Battle.net bottle (is my pad seen?)
  soju vr setup       D2R in VR (offline): copy the Battle.net bottle and install D2R VR Unleashed
  soju vr play        Play D2R in VR (OXRSys client on the headset; offline characters)
  soju vr play --flat Open the VR copy without VR to create offline characters with the mouse
  soju vr status|remove

  soju epic-install   Set up the Epic Games Launcher bottle (same engine)
  soju epic           Launch the Epic Games Launcher
  soju epic-kill      Stop everything in the Epic bottle
  soju gog-install    Set up the GOG GALAXY bottle (same engine)
  soju gog            Launch GOG GALAXY
  soju gog-kill       Stop everything in the GOG bottle

  soju ea-install      Set up the EA app bottle (launcher engine, EA's official installer)
  soju ea              Launch the EA app
  soju ea-kill         Stop everything in the EA app bottle
  soju rockstar-install  Set up the Rockstar Games Launcher bottle
  soju rockstar        Launch the Rockstar Games Launcher
  soju rockstar-kill   Stop everything in the Rockstar bottle
  soju ubisoft-install Set up the Ubisoft Connect bottle
  soju ubisoft         Launch Ubisoft Connect
  soju ubisoft-kill    Stop everything in the Ubisoft Connect bottle

  soju xbox-install   Build the Xodus backend for Xbox PC / Microsoft Store (Rust, a few minutes)
  soju xbox-login     Sign in with your Microsoft account (official page in a window)
  soju xbox-logout    Sign out (downloaded games are kept)
  soju xbox-sync [US|KR|GB|DE|JP]  Import your owned and PC Game Pass games
  soju xbox-download <ProductId>  Download an owned game (resumable)
  soju xbox-location [<folder>|--default]  Where new Xbox downloads go (an external APFS or exFAT drive works)
  soju storage move <game id> <folder>     Move a Battle.net game's files to another drive (storage back <game id> returns them)
  soju storage import battlenet <folder>   Use a Battle.net game folder you already have, without copying
  soju storage place battlenet "<Name>" <folder>  Before installing: keep that game on another drive
  soju xbox-run <ProductId>  Play a downloaded game (experimental)
  soju xbox-kill      Stop a running Xbox download or game

  soju steam-install  Set up the Steam bottle (private Wine 11 + wrapper + Steam)
  soju steam-games    Download and configure verified D3D11 components
  soju steam-games renderer <dxvk|dxmt|reset|status> <game.exe path>
                     Choose a renderer for one 64-bit game (close Steam first)
  soju steam          Launch Steam
  soju steam-kill     Stop everything in the Steam bottle
  soju steam-gptk on|off|status
                     Run Steam and its games on Apple GPTK (D3D12 games, Overwatch and Diablo II on Steam); sign in once

  soju gptk           Install Apple's GPTK payload into the engine (downloads it; a mounted dmg or CrossOver is used if present)
  soju fps on|off     Show frame rate and frame time in games (Apple's Metal HUD), from the next launch
  soju sweep          Remove orphaned Wine service processes (only when no bottle is running)
  soju doctor         Check the whole stack and print what is wrong
  soju update         Update the scripts and the prebuilt engine
  soju uninstall      Remove apps, bottles and the engine (asks per item)

Docs: https://github.com/BCD1210/soju
EOF
}

case "${1:-}" in
  search)         shift; exec python3 "$ROOT/scripts/library-service.py" search "$@" ;;
  game-install)   shift; exec python3 "$ROOT/scripts/game-library.py" install "$@" ;;
  library)        exec python3 "$ROOT/scripts/game-library.py" list ;;
  game)           shift; exec python3 "$ROOT/scripts/game-library.py" launch "$@" ;;
  didim)          shift; exec python3 "$ROOT/scripts/didim_games.py" "$@" ;;
  report)         shift; exec python3 "$ROOT/scripts/report.py" "$@" ;;
  --version)      cat "$ROOT/VERSION" ;;
  app)            exec bash "$ROOT/scripts/install-app.sh" ;;
  install)        shift; exec bash "$ROOT/install.sh" "$@" ;;
  epic-install)   shift; exec bash "$ROOT/scripts/create-epic-bottle.sh" "$@" ;;
  gog-install)    shift; exec bash "$ROOT/scripts/create-gog-bottle.sh" "$@" ;;
  ea-install|rockstar-install|ubisoft-install)
                  exec bash "$ROOT/scripts/create-launcher-bottle.sh" "${1%-install}" ;;
  steam-install)  shift; export SOJU_PLATFORMS=steam; exec bash "$ROOT/install.sh" "$@" ;;
  vr)             shift; exec python3 "$ROOT/scripts/d2r-vr.py" "$@" ;;
  xbox-install)   exec bash "$ROOT/scripts/xbox.sh" install ;;
  xbox-login)     exec bash "$ROOT/scripts/xbox.sh" login ;;
  xbox-logout)    shift; exec bash "$ROOT/scripts/xbox.sh" logout "$@" ;;
  xbox-kill)      exec bash "$ROOT/scripts/xbox.sh" kill ;;
  xbox-location)  shift; exec bash "$ROOT/scripts/xbox.sh" location "$@" ;;
  storage)  shift; exec python3 "$ROOT/scripts/game-storage.py" "$@" ;;
  xbox-run)       shift; exec python3 "$ROOT/scripts/game-library.py" launch "xbox:${1:?Choose a Store product ID}" ;;
  xbox-download)  shift; exec python3 "$ROOT/scripts/game-library.py" install "xbox:${1:?Choose a Store product ID}" ;;
  xbox-sync)
    market="${2:-US}"
    case "$market" in US|KR|GB|DE|JP) ;; *) echo "soju: choose US, KR, GB, DE or JP" >&2; exit 64 ;; esac
    printf '{"market":"%s"}' "$market" | exec python3 "$ROOT/scripts/library-service.py" sync xbox ;;
  steam-games)    shift; exec bash "$ROOT/scripts/setup-steam-games.sh" "$@" ;;
  steam-gptk)     shift; exec bash "$ROOT/scripts/steam-gptk.sh" "$@" ;;
  gptk)           shift
    # A path, a mounted dmg or CrossOver is used as it is; otherwise Soju downloads the payload.
    if [ "${1:-}" = "--download" ]; then exec python3 "$ROOT/scripts/fetch-gptk.py"; fi
    if [ $# -gt 0 ] || bash "$ROOT/scripts/get-gptk.sh" --find >/dev/null 2>&1; then exec bash "$ROOT/scripts/get-gptk.sh" "$@"; fi
    exec python3 "$ROOT/scripts/fetch-gptk.py" ;;
  fps)
    f="${SOJU_BASE:-$HOME/.battlenet-macos}/fps-hud"
    case "${2:-status}" in
      on)  mkdir -p "$(dirname "$f")" && : > "$f" && echo "FPS display on: games started from now show Apple's Metal HUD" ;;
      off) rm -f "$f" && echo "FPS display off (from the next launch)" ;;
      status) [ -f "$f" ] && echo on || echo off ;;
      *) echo "usage: soju fps on|off|status" >&2; exit 64 ;;
    esac ;;
  sweep)          shift; exec bash "$ROOT/scripts/soju-sweep.sh" "$@" ;;
  doctor)         shift; exec bash "$ROOT/scripts/doctor.sh" "$@" ;;
  update)         shift; exec bash "$ROOT/scripts/update.sh" "$@" ;;
  uninstall)      shift; exec bash "$ROOT/scripts/uninstall.sh" "$@" ;;
  battlenet|d2r|controllers|epic|epic-kill|gog|gog-kill|ea|ea-kill|rockstar|rockstar-kill|ubisoft|ubisoft-kill|steam|kill|steam-kill)
                  exec bash "$ROOT/scripts/play.sh" "$@" ;;
  -h|--help|help|"") usage ;;
  *) echo "soju: unknown command '$1'" >&2; usage >&2; exit 64 ;;
esac
